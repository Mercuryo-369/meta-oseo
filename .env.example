# Copiar a .env (raíz). Nunca commitear .env.
# Lo leen services/api (pydantic-settings) y docker-compose.yml.
# Los valores de este archivo sirven para DESARROLLO tal cual. Para publicar, cambiar primero lo
# de la sección siguiente.

# =====================================================================================
# CAMBIAR OBLIGATORIAMENTE ANTES DE PUBLICAR (ENV=prod / docker compose)
# Con los valores de desarrollo de abajo, en producción la API se niega a arrancar o el sitio
# queda inseguro y con certificados de enlace falso.
# =====================================================================================

# SECRET_KEY: firma las sesiones. En producción exige 32+ caracteres y que no sea este valor.
#   Generarla:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#   Si se cambia, todas las sesiones abiertas dejan de valer.
SECRET_KEY=cambiar-en-produccion         # obligatorio y distinto del valor por defecto cuando ENV=prod

# POSTGRES_PASSWORD: contraseña de la base de Docker Compose (no la usa el desarrollo con SQLite).
#   Generarla alfanumérica (va dentro de una URL; evitar @ : / ? # %):
#     python -c "import secrets; print(secrets.token_hex(24))"
#   Docker Compose no arranca sin ella; "ova" es una contraseña conocida.
POSTGRES_PASSWORD=ova

# PUBLIC_BASE_URL: dirección pública del sitio, con http(s):// y sin barra final (por ejemplo
#   https://ova.midominio.edu). Va impresa en cada certificado como enlace de verificación
#   ({PUBLIC_BASE_URL}/verify/{codigo}). Con ENV=prod la API no arranca si apunta a localhost o
#   127.0.0.1, y Docker Compose la exige. Para probar Docker en el mismo equipo usar la IP de la
#   red local (http://192.168.1.20:8080), nunca localhost.
PUBLIC_BASE_URL=http://localhost:5173    # en desarrollo (Vite). Docker/producción: la dirección real

# ALLOWED_ORIGINS: orígenes CORS permitidos, separados por coma; en producción, la misma
#   dirección que PUBLIC_BASE_URL (sin barra final). Con nginx de Docker el navegador usa un solo
#   origen y casi no interviene, pero debe coincidir con el sitio publicado.
ALLOWED_ORIGINS=http://localhost:5173    # separados por coma

# =====================================================================================
# Resto de la configuración (los valores de abajo sirven tal cual en desarrollo y en producción)
# =====================================================================================

ENV=dev                                  # dev | prod. docker-compose.yml fija prod para la API
ACCESS_TOKEN_EXPIRE_MINUTES=10080        # 7 días

DATABASE_URL=sqlite:///./data/ova.db     # dev. En Docker: postgresql+psycopg://ova:ova@db:5432/ova (compose la arma sola)
TRUST_PROXY=false                        # true solo detrás de un proxy que SOBRESCRIBE X-Forwarded-For (límite de intentos por IP)

# Solo el backend la usa. Vacía => /api/chat responde 503.
# (El comentario va en su propia línea: un valor vacío seguido de "# ..." se leería como texto.)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
MENTOR_EFFORT=medium                     # low | medium | high | xhigh | max
MENTOR_MAX_TOKENS=16000
MENTOR_SERVER_FALLBACK=true              # beta de Anthropic; poner false si la organización no la tiene habilitada
MENTOR_MAX_MENSAJES_DIA=60               # mensajes por estudiante y día (calendario de Colombia); 0 = sin límite
MENTOR_MAX_QUIZ_DIA=20                   # quizzes de práctica del mentor por estudiante y día; 0 = sin límite
MENTOR_RAG_TOP_K=5                       # fragmentos del curso que se recuperan por pregunta (1 a 10)
RAG_BACKEND=bm25                         # bm25 (hoy). pgvector queda reservado para F6-10 (aún no implementado)
# Corpus del mentor: por defecto services/api/app/data/corpus.jsonl (se genera con
# `python -m app.scripts.build_corpus`). Descomentar solo para usar otro archivo (debe existir) o dejarlo
# vacío para responder sin material del curso.
# RAG_CORPUS_PATH=

# Certificado y validación contra el contenido (F5-05). PUBLIC_BASE_URL está arriba.
# Manifiesto de actividades: por defecto services/api/app/data/actividades_manifest.json; si existe,
# la API valida resultados y progreso contra él (se genera con `python -m app.scripts.build_manifest`).
# Descomentar solo para usar otra ruta (debe existir) o dejarla vacía para desactivar la validación.
# ACTIVITIES_MANIFEST_PATH=
CERT_MIN_PORCENTAJE=70                   # % mínimo del puntaje máximo de las actividades obligatorias (solo con manifiesto)

# Solo docker-compose. POSTGRES_PASSWORD está arriba.
POSTGRES_USER=ova
POSTGRES_DB=ova

# Bloqueo por secuencia de módulos (interfaz). Solo docker-compose: lo pasa como argumento de
# construcción de la imagen web, porque Vite lo incrusta al COMPILAR (cambiarlo exige
# `docker compose build web`). true (por defecto) = cada módulo exige completar el anterior;
# false = los seis abiertos. Otro valor equivale a true. No la lee la API. Sin Docker, en
# desarrollo: VITE_BLOQUEO_SECUENCIAL=false pnpm dev:web
VITE_BLOQUEO_SECUENCIAL=true

# Panel docente: precios para ESTIMAR el costo del mentor (USD por millón de tokens).
# Por defecto, las tarifas de claude-opus-5. Ajustar si cambia el modelo o la tarifa.
PRECIO_ENTRADA_USD_POR_MTOK=5
PRECIO_SALIDA_USD_POR_MTOK=25

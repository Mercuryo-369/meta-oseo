{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ova-metabolismo-oseo",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ova",
      "database_id": "d5e3f4ac-f4a9-46c1-bbde-2ab0bc45f77d",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "LIMITE_ACCESO", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "LIMITE_CHAT", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "LIMITE_VERIFICAR", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    { "name": "LIMITE_PDF", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } }
  ],
  "rules": [
    { "type": "Text", "globs": ["**/*.jsonl", "**/*.md"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.jpg"], "fallthrough": true }
  ],
  "vars": {
    "ENV": "prod",
    "PUBLIC_BASE_URL": "https://ova-metabolismo-oseo.juan-riosromero07.workers.dev",
    "ANTHROPIC_MODEL": "claude-opus-5"
  },
  "observability": {
    "enabled": true
  }
}
